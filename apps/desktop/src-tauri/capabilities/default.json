{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-theme",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "shell:default",
    "dialog:default",
    "log:default"
  ]
}
