{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diarist",
  "version": "0.1.0-beta.2",
  "identifier": "app.diarist.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Diarist",
        "width": 1120,
        "height": 650,
        "center": true,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Local meeting transcription with speaker labels",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3NTI1Q0M4QzIzQzQ2QkMKUldTOFJqekN5RnhTOS90UldGbnQrTVdlSUQ0d05tdE8xZUhnQWg3b3h5cm00T01uTzVLeFZ1TDYK",
      "endpoints": [
        "https://raw.githubusercontent.com/ebt55/diarist/main/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
